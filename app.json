{
    "expo": {
        "name": "ShopYethu",
        "slug": "ShopYethu",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/shopyethu-icon.png",
        "scheme": "shopyethu",
        "userInterfaceStyle": "light",
        "ios": {
            "bundleIdentifier": "za.co.chefu.shopyethu"
        },
        "android": {
            "package": "za.co.chefu.shopyethu",
            "adaptiveIcon": {
                "backgroundColor": "#244D3B",
                "foregroundImage": "./assets/images/shopyethu-icon.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "server",
            "favicon": "./assets/images/shopyethu-icon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#F7F6F1",
                    "image": "./assets/images/shopyethu-icon.png",
                    "imageWidth": 96
                }
            ],
            "expo-secure-store",
            ["expo-image-picker", { "photosPermission": "Choose photos for your ShopYethu products.", "microphonePermission": false }]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
