{
  "expo": {
    "name": "ShopYethu",
    "slug": "ShopYethu",
    "version": "1.0.0",
    "orientation": "default",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/images/shopyethu-launcher-icon.png",
    "scheme": "shopyethu",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "za.co.chefu.shopyethu",
      "associatedDomains": [
        "applinks:api.chefu.co.za"
      ]
    },
    "android": {
      "package": "za.co.chefu.shopyethu",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.chefu.co.za",
              "pathPrefix": "/shopyethu/store/"
            },
            {
              "scheme": "https",
              "host": "api.chefu.co.za",
              "pathPrefix": "/shopyethu/product/"
            },
            {
              "scheme": "https",
              "host": "api.chefu.co.za",
              "pathPrefix": "/shopyethu/order/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#12483D",
        "foregroundImage": "./assets/images/shopyethu-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12483D",
          "image": "./assets/images/shopyethu-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your ShopYethu products.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "237453a3-8114-4f1e-be36-496e04793cfd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/237453a3-8114-4f1e-be36-496e04793cfd"
    }
  }
}
